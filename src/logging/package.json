{
  "name": "commonjs-logger",
  "version": "0.0.0-zlux.version.replacement",
  "description": "The zLUX common logger for both Client and Server.",
  "license": "private",
  "scripts": {
    "build": "tsc",
    "start": "tsc --watch",
    "test": "NODE_PATH=./node_modules mocha ../../test/logging/**/*.js ../../test/obfuscator/**/*.js --timeout 10000 --exit",
    "test:coverage": "NODE_PATH=./node_modules c8 mocha ../../test/logging/**/*.js ../../test/obfuscator/**/*.js --timeout 10000 --exit",
    "test:coverage:report": "c8 report --reporter=html"
  },
  "author": "Sean Grady",
  "devDependencies": {
    "@types/core-js": "2.5.5",
    "@types/node": "14.14.22",
    "core-js": "3.19.0",
    "mocha": "10.3.0",
    "rxjs": "7.4.0",
    "sinon": "17.0.1",
    "typescript": "4.2.4",
    "c8": "10.1.3"
  }
}
